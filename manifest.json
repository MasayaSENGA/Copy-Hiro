{
  "manifest_version": 3,
  "name": "コピひろ",
  "version": "2.4.1",
  "description": "Webページの表（テーブル）を右クリックメニューからコピーできます。Excelやスプレッドシートに貼り付けるとセルごとに分かれるタブ区切り（TSV）形式と、Markdown形式に対応しています。ページ上の全テーブルもまとめてコピーできます。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "clipboardWrite", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}