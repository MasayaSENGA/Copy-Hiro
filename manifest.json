{
  "manifest_version": 3,
  "name": "コピひろ",
  "version": "2.3",
  "description": "テーブルを右クリックしてクリップボードにコピーします",
    "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"},
  "permissions": ["contextMenus", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}